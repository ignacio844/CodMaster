# Credencial pública creada en Google Cloud Console para una aplicación web OAuth 2.0.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Cadena aleatoria larga usada para firmar las sesiones. No debe subirse al repositorio.
AUTH_SECRET=reemplazar-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# Neon Postgres. Vercel la inyecta al conectar una base Neon al proyecto.
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Vercel Blob privado. Vercel la inyecta al conectar el Blob Store al proyecto.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_reemplazar
